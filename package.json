{
  "name": "oz-timber-floor-static-migration",
  "private": true,
  "version": "1.0.0",
  "description": "Local launch-safety controls for the Oz Timber Floor static Netlify site.",
  "scripts": {
    "build": "node scripts/prepare-netlify-deploy.mjs && npm run catalogue:apply",
    "catalogue:apply": "node scripts/migration-readiness.mjs --apply-catalogue-only",
    "catalogue:approve-release-decisions": "node scripts/apply-approved-release-decisions.mjs --apply && npm run catalogue:apply",
    "catalogue:fix-indexable-metadata": "node scripts/fix-indexable-catalogue-metadata.mjs --apply",
    "migration:check": "node scripts/migration-readiness.mjs",
    "migration:check:local": "node scripts/migration-readiness.mjs --allow-external"
  }
}
